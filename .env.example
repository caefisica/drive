# Copy this file to .env.local and fill in real values for local development.

# JSON array of drive configurations.
# Each entry: { name, rootId, clientId, clientSecret, refreshToken, kind? }
# kind: "my_drive" (default) | "shared_drive" | "folder"
#   my_drive    — rootId is "root" or any folder inside your own Drive
#   shared_drive — rootId is the Team Drive ID (the drive itself, not a subfolder)
#   folder      — rootId is a folder ID shared with you from someone else's Drive
DRIVES='[
  {"name":"My Drive","kind":"my_drive","rootId":"root","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","refreshToken":"YOUR_REFRESH_TOKEN"},
  {"name":"Physics Dept","kind":"shared_drive","rootId":"0ANVP75EAintnUk9PVA","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","refreshToken":"YOUR_REFRESH_TOKEN"},
  {"name":"Shared Docs","kind":"folder","rootId":"1abc_FOLDER_ID","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","refreshToken":"YOUR_REFRESH_TOKEN"}
]'

# HMAC secret for signing stream/download tokens (generate with: openssl rand -base64 32)
STREAM_SECRET=change-me-stream-secret

# HMAC secret for signing folder-unlock cookies (generate with: openssl rand -base64 32)
UNLOCK_SECRET=change-me-unlock-secret

# Optional: shared secret for Google Drive push notification webhooks
# WEBHOOK_SECRET=change-me-webhook-secret
