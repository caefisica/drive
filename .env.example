# Copy this file to .env.local and fill in real values for local development.

DRIVES='[
  {"name":"My Drive","kind":"my_drive","rootId":"root","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","refreshToken":"YOUR_REFRESH_TOKEN"},
  {"name":"Physics Dept","kind":"shared_drive","rootId":"YOUR_SHARED_DRIVE_ID","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","refreshToken":"YOUR_REFRESH_TOKEN"},
  {"name":"Shared Docs","kind":"folder","rootId":"YOUR_FOLDER_ID","clientId":"YOUR_CLIENT_ID","clientSecret":"YOUR_CLIENT_SECRET","refreshToken":"YOUR_REFRESH_TOKEN"}
]'

# Generate secrets with: openssl rand -base64 32
STREAM_SECRET=change-me-stream-secret
UNLOCK_SECRET=change-me-unlock-secret

# Optional token for Google Drive push notifications.
# WEBHOOK_SECRET=change-me-webhook-secret
