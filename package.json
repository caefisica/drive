{
  "type": "module",
  "scripts": {
    "postinstall": "vp config",
    "build": "vp build",
    "dev": "vp dev",
    "preview": "vp preview",
    "lint": "vp lint --deny-warnings && vp fmt --check",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test run",
    "check": "bun run build && bun run lint && bun run typecheck && bun run test",
    "fix": "bun run build && vp lint --fix && vp fmt",
    "db:generate": "vp exec void db generate",
    "db:migrate": "vp exec void db migrate",
    "db:migrate:remote": "vp exec void db migrate --remote",
    "release:connect": "vp exec void connect --platform cloudflare",
    "release:secret": "vp exec void secret put",
    "release:app": "vp exec void deploy"
  },
  "dependencies": {
    "@void/vue": "^1.1.12",
    "drizzle-orm": "^0.45.4",
    "markdown-it": "^15.0.3",
    "shiki": "^4.5.0",
    "unocss": "^66.11.0",
    "vite-plus": "^1.3.0",
    "void": "^1.1.12",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@types/markdown-it": "^14.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.3"
  },
  "packageManager": "bun@1.4.0"
}
